 "phrases": [
  {
   "k": 0,
   "start": 0.0,
   "end": 1.9667,
   "text": "aku nak bagi tahu satu info yang penting,"
  },
  {
   "k": 1,
   "start": 1.9667,
   "end": 4.3334,
   "text": "hujung minggu ni, hari Sabtu dan Ahad"
  },
  {
   "k": 2,
   "start": 4.3334,
   "end": 11.3001,
   "text": "di Perodua 3S Jalan Reko, kita ada beberapa program menarik lah. Seperti kita ada buat free inspection untuk kereta-kereta lama."
  },
  {
   "k": 3,
   "start": 11.3001,
   "end": 16.8335,
   "text": "Kita juga ada buat sediakan untuk submission loan face to face. Sebab kita ada bawa banker panel sekali."
  },
  {
   "k": 4,
   "start": 16.8335,
   "end": 25.8001,
   "text": "Kita juga ada untuk siapa yang nak cek kesihatan, boleh datang juga dekat sini. Ataupun kita juga menyediakan permainan VR game dan makanan juga disediakan."
  },
  {
   "k": 5,
   "start": 25.8001,
   "end": 33.5334,
   "text": "Jadi siapa-siapa orang yang berdekatan dengan Kajang ataupun sekitarnya, kami mengalu-alukan kedatangan anda untuk datang ke showroom kami."
  },
  {
   "k": 6,
   "start": 33.5334,
   "end": 39.7001,
   "text": "Hari Sabtu dan Ahad ni, kalau siapa nak datang boleh jumpa dengan Shauky. InsyaAllah kita jumpa nanti. Assalamualaikum."
  }
 ],
